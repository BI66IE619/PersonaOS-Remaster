# Environment
NEXT_PUBLIC_SUPABASE_URL=https://mdwcllvnecxmpdqhsbvq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# OpenAI
OPENAI_API_KEY=

# SimpleFIN
# FINANCE_ENCRYPTION_KEY encrypts the bank credential at rest (AES-256-GCM). It is
# 32 bytes, written as 64 hex characters. Losing it means reconnecting the account;
# it is not recoverable from the database, so keep it out of version control and
# somewhere you would not lose it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FINANCE_ENCRYPTION_KEY=

# Only for a self-hosted SimpleFIN instance. Unset means the public host, and the
# allowlist in lib/finance/simplefin.ts accepts nothing else.
# SIMPLEFIN_BASE_URL=https://beta.simplefin.org
# SIMPLEFIN_ALLOWED_HOST=

# How often a manual sync is allowed, in minutes. Defaults to 30 (twice an hour).
# Raise it if SimpleFIN ever disables the token for overuse.
# SIMPLEFIN_MIN_SYNC_GAP_MINUTES=30

# Playwright test authentication
# EMAIL_SIGNIN=1 opens app/auth/password/route.ts, which the suites use to get a
# real session. Leave it unset in production: with it unset the route is a 404 and
# Google is the only way in.
# EMAIL_SIGNIN=1
# The browser-side half of the same switch. Both must be "1" for the email form to
# appear on the sign-in card; leave both unset in production.
# NEXT_PUBLIC_EMAIL_SIGNIN=1
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
