# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Saved by scripts/auth-setup.mjs. Live session cookies for the throwaway test
# account — regenerable, and not something that belongs in a repository.
/playwright/auth.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local dev server output and scratch logs
*.log

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is committed and must never hold a real value.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
